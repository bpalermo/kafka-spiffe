load("@rules_java//java:defs.bzl", "java_library")
load("//bazel/java:defs.bzl", "JAVACOPTS")

java_library(
    name = "kafka",
    srcs = glob(["*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//bazel/maven:kafka_clients_provided",
        "//bazel/maven:slf4j_api_provided",
        "//src/main/java/io/github/bpalermo/kafka/spiffe/id",
        "//src/main/java/io/github/bpalermo/kafka/spiffe/workload",
        "//src/main/java/io/github/bpalermo/kafka/spiffe/x509",
    ],
)
