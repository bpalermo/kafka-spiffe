load("//bazel/java:defs.bzl", "JAVACOPTS")
load("//bazel/java:junit.bzl", "java_junit_test")

java_junit_test(
    name = "h2_test",
    srcs = [
        "GrpcCallTest.java",
        "HpackTest.java",
    ],
    javacopts = JAVACOPTS,
    test_classes = [
        "io.github.bpalermo.kafka.spiffe.workload.h2.GrpcCallTest",
        "io.github.bpalermo.kafka.spiffe.workload.h2.HpackTest",
    ],
    deps = [
        "//src/main/java/io/github/bpalermo/kafka/spiffe/workload/h2",
        "@maven//:io_netty_netty_buffer",
        "@maven//:io_netty_netty_codec_http2",
        "@maven//:io_netty_netty_common",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# The client against grpc-java's server on a Unix domain socket (Netty's epoll, Linux).
java_junit_test(
    name = "h2_interop_test",
    size = "medium",
    srcs = ["GrpcInteropTest.java"],
    javacopts = JAVACOPTS,
    test_classes = ["io.github.bpalermo.kafka.spiffe.workload.h2.GrpcInteropTest"],
    runtime_deps = ["//bazel/maven:netty_epoll_native"],
    deps = [
        "//src/main/java/io/github/bpalermo/kafka/spiffe/workload/h2",
        "@maven//:io_grpc_grpc_api",
        "@maven//:io_grpc_grpc_netty",
        "@maven//:io_grpc_grpc_stub",
        "@maven//:io_netty_netty_transport",
        "@maven//:io_netty_netty_transport_classes_epoll",
        "@maven//:io_netty_netty_transport_native_unix_common",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)
