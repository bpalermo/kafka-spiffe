"""kafka-spiffe: SPIFFE mutual TLS for Apache Kafka brokers and clients, 3.0 and later."""

module(
    name = "kafka_spiffe",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Formatting and linting.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# --- Maven -----------------------------------------------------------------------
# The library is compiled ONCE, against the main `@maven` repository, whose
# kafka-clients is 3.0.0: the oldest version the library supports, so nothing newer
# is called by accident. kafka-clients and slf4j-api are provided by whoever runs
# the library and are never shipped: //bazel/maven:kafka_clients_provided and
# :slf4j_api_provided are neverlink targets over them.
#
# gRPC and Netty come from Maven (there are no protos to compile). Netty is pinned
# to 4.2.16.Final, the version grpc-java 1.84.3 is built against. Unix domain sockets
# for grpc-netty need Netty's epoll transport, and its native library is a per-arch
# classifier jar; both architectures are listed, and the build picks one with a
# select() on the target CPU (//bazel/maven:netty_epoll_native).
#
# The resolved tree, with checksums, is pinned in //bazel/maven:maven_install.json.
# Re-pin after editing this list: `REPIN=1 bazel run @maven//:pin`.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        # Provided at compile time; the floor of the supported range. Also in the
        # published POM (bazel/maven/pom.tpl), as a provided dependency.
        "org.apache.kafka:kafka-clients:3.0.0",
        # Provided; 1.7.x is the API Kafka 3.0 ships, and what is called here exists in 2.x too.
        # Also in bazel/maven/pom.tpl.
        "org.slf4j:slf4j-api:1.7.36",
        # Tests only: grpc-java on Netty's epoll serves the fake Workload API, and Netty's
        # HPACK checks ours. Nothing of it reaches the library (design, section 3).
        "io.grpc:grpc-api:1.84.3",
        "io.grpc:grpc-core:1.84.3",
        "io.grpc:grpc-stub:1.84.3",
        "io.grpc:grpc-netty:1.84.3",
        "io.netty:netty-codec-http2:4.2.16.Final",
        "io.netty:netty-common:4.2.16.Final",
        "io.netty:netty-transport-native-epoll:jar:linux-x86_64:4.2.16.Final",
        "io.netty:netty-transport-native-epoll:jar:linux-aarch_64:4.2.16.Final",
        "io.netty:netty-transport-native-unix-common:4.2.16.Final",
        "io.netty:netty-transport:4.2.16.Final",
        "io.netty:netty-transport-classes-epoll:4.2.16.Final",
        "io.netty:netty-buffer:4.2.16.Final",
        "io.netty:netty-handler:4.2.16.Final",
        # Tests only: JUnit (Jupiter) on the JUnit Platform console launcher.
        "org.junit.jupiter:junit-jupiter-api:6.1.3",
        "org.junit.jupiter:junit-jupiter-engine:6.1.3",
        "org.junit.platform:junit-platform-console:6.1.3",
        # Tests only: certificates generated in the test, and the wire bytes the
        # Workload API reader is checked against (protobuf's CodedOutputStream).
        "org.bouncycastle:bcprov-jdk18on:1.86",
        "org.bouncycastle:bcpkix-jdk18on:1.86",
        "com.google.protobuf:protobuf-java:4.36.2",
        # Tests only (e2e): SPIRE servers and agents in containers, started by the test.
        "org.testcontainers:testcontainers:2.0.5",
        "com.github.docker-java:docker-java-api:3.7.1",
    ],
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
    lock_file = "//bazel/maven:maven_install.json",
    repositories = ["https://repo.maven.apache.org/maven2/"],
    strict_visibility = True,
)

# One repository per Kafka version the tests run against (design §9), so the tests
# of one version never see another's jars. Each has its own lockfile. A repository
# holds the version's kafka-clients; from 3.3 (the first with KRaft in production)
# kafka-metadata for StandardAuthorizer; and the broker and its test cluster for the
# broker tests (design §9, "In-process test clusters"): 3.0's for ZooKeeper, 3.3's to
# 4.4's for KRaft, 3.9's for both. JUnit and Netty (which ZooKeeper brings to 3.x) are
# left out of them: the tests run on the main repository's JUnit, which Kafka's test
# clusters only call for assertions, and the fake Workload API on its Netty, which a
# broker does not use (ZooKeeper and its clients default to NIO).
# Re-pin one: `REPIN=1 bazel run @kafka_3_3//:pin`.
#
# Versions are the latest patch release of each line in the matrix.
KAFKA_EXCLUDED = [
    "io.netty:netty-buffer",
    "io.netty:netty-codec",
    "io.netty:netty-common",
    "io.netty:netty-handler",
    "io.netty:netty-resolver",
    "io.netty:netty-transport",
    "io.netty:netty-transport-classes-epoll",
    "io.netty:netty-transport-native-epoll",
    "io.netty:netty-transport-native-unix-common",
    "org.junit.jupiter:junit-jupiter",
    "org.junit.jupiter:junit-jupiter-api",
    "org.junit.jupiter:junit-jupiter-engine",
    "org.junit.jupiter:junit-jupiter-params",
    "org.junit.platform:junit-platform-commons",
    "org.junit.platform:junit-platform-engine",
    "org.junit.platform:junit-platform-launcher",
    "org.opentest4j:opentest4j",
]

[
    maven.install(
        name = "kafka_" + line,
        artifacts = ["org.apache.kafka:kafka-clients:" + version] + [
            a.format(v = version)
            for a in extra
        ],
        excluded_artifacts = KAFKA_EXCLUDED,
        fail_if_repin_required = True,
        lock_file = "//bazel/maven:kafka_%s_install.json" % line,
        repositories = ["https://repo.maven.apache.org/maven2/"],
        strict_visibility = True,
    )
    for line, version, extra in [
        (
            "3_0",
            "3.0.2",
            [
                "org.apache.kafka:kafka_2.13:{v}",
                "org.apache.kafka:kafka_2.13:jar:test:{v}",
                "org.apache.kafka:kafka-clients:jar:test:{v}",
                "org.apache.kafka:kafka-server-common:jar:test:{v}",
            ],
        ),
        (
            "3_3",
            "3.3.2",
            [
                "org.apache.kafka:kafka-metadata:{v}",
                "org.apache.kafka:kafka_2.13:{v}",
                "org.apache.kafka:kafka_2.13:jar:test:{v}",
                "org.apache.kafka:kafka-clients:jar:test:{v}",
                "org.apache.kafka:kafka-server-common:jar:test:{v}",
                "org.apache.kafka:kafka-metadata:jar:test:{v}",
            ],
        ),
        (
            "3_9",
            "3.9.2",
            [
                "org.apache.kafka:kafka-metadata:{v}",
                "org.apache.kafka:kafka_2.13:{v}",
                "org.apache.kafka:kafka_2.13:jar:test:{v}",
                "org.apache.kafka:kafka-clients:jar:test:{v}",
                "org.apache.kafka:kafka-server-common:jar:test:{v}",
            ],
        ),
        (
            "4_0",
            "4.0.2",
            [
                "org.apache.kafka:kafka-metadata:{v}",
                "org.apache.kafka:kafka_2.13:{v}",
                "org.apache.kafka:kafka-test-common-runtime:{v}",
            ],
        ),
        (
            "4_4",
            "4.4.0",
            [
                "org.apache.kafka:kafka-metadata:{v}",
                "org.apache.kafka:kafka_2.13:{v}",
                "org.apache.kafka:kafka-test-common-runtime:{v}",
                "org.apache.kafka:kafka-clients:jar:test-fixtures:{v}",
                "org.bouncycastle:bcpkix-jdk18on:1.86",
            ],
        ),
    ]
]

use_repo(
    maven,
    "kafka_3_0",
    "kafka_3_3",
    "kafka_3_9",
    "kafka_4_0",
    "kafka_4_4",
    "maven",
)

# --- Formatter and linter tools --------------------------------------------------
# google-java-format: aspect_rules_lint bundles only 1.17.0, which predates
# current Java syntax, so the jar is pinned here instead (//bazel/format wraps it
# in a java_binary). Bump = new version + new sha256.
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "google_java_format",
    sha256 = "834b2a0c38cb774953322a84b5ca3f2f40dd3156650b3cd44d3b744345962f7a",
    url = "https://github.com/google/google-java-format/releases/download/v1.37.0/google-java-format-1.37.0-all-deps.jar",
)

# PMD: Java lint (rules_lint aspect, //bazel/lint). aspect_rules_lint bundles only
# 7.7.0, which cannot parse Java 25, so the distribution is pinned here instead.
# Bump = new version in the URL and prefix + new sha256.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "net_sourceforge_pmd",
    build_file_content = """\
load("@rules_java//java:defs.bzl", "java_import")

java_import(
    name = "net_sourceforge_pmd",
    jars = glob(["*.jar"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "f974ba571f7bc01c73fffe11bade25fbc1f438698f9e9c00e416e8d65e9fbac2",
    strip_prefix = "pmd-bin-7.28.0/lib",
    url = "https://github.com/pmd/pmd/releases/download/pmd_releases/7.28.0/pmd-dist-7.28.0-bin.zip",
)

# --- Kafka distributions ---------------------------------------------------------
# A broker's libs/, for the test of the published jar beside them (design §9, "The
# jar"): the oldest and the newest version of the matrix. Test-only, and fetched only
# by those targets, which are `manual` (CI runs them in the `jar` job). The sha256 is
# of the archive whose sha512 matched the one Apache publishes beside it.
# Bump = new version in the URL and prefix + new sha256.
[
    http_archive(
        name = "kafka_dist_" + line,
        # The jars are also exported one by one, so a test can name one of them to find
        # the directory.
        build_file_content = """\
exports_files(glob(["libs/*.jar"]))

filegroup(
    name = "libs",
    srcs = glob(["libs/*.jar"]),
    visibility = ["//visibility:public"],
)
""",
        sha256 = sha256,
        strip_prefix = "kafka_2.13-" + version,
        urls = ["https://archive.apache.org/dist/kafka/%s/kafka_2.13-%s.tgz" % (version, version)],
    )
    for line, version, sha256 in [
        ("3_0", "3.0.2", "1bc6fa4931a5c28c3e883a8c09e6641771d329df784ca71c9b27d9ec04ffef21"),
        ("4_4", "4.4.0", "5d46df16e8dbd228fed83c3e6fc4306916cf3d9156184a7fc2462e9ad9711a7d"),
    ]
]
