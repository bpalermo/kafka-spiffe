# Bazel 9, bzlmod only. Run `bazel help <command>` for any flag below.

# aspect_rules_lint >= 2.9.0 depends on @aspect_tools_telemetry, whose repository
# rule posts a usage report to telemetry.aspect.build. Opt out for everyone (local
# and CI): an un-hermetic outbound request from a repo rule has no place here.
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

# --- Java toolchain: hermetic JDKs, never the host's --------------------------------
# Bytecode is Java 17 and compiled against the JDK 17 class library, so a later API
# fails to compile. The build tools (javac with Error Prone, google-java-format, PMD)
# run on the newer tool runtime.
build --java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_language_version=25
build --tool_java_runtime_version=remotejdk_25

# google-java-format 1.37 needs a JDK newer than 17 and runs in the target configuration,
# so `bazel run` (which runs //:format) uses the tool JDK. Tests are not affected: they
# run under `bazel test`.
run --java_runtime_version=remotejdk_25

# The release workflow builds, signs and publishes with --config=release. Without it,
# `bazel run //:kafka-spiffe.publish` would compile the library against the JDK 25 class
# library (the line above): bytes that differ from the jar the verify job tested and the
# GitHub release signs, and a later API that compiles. The workflow checks the hashes.
build:release --java_runtime_version=remotejdk_17

# Run the tests on another JDK (usage: bazel test --config=jdk21 //...). Only the
# runtime changes: the bytecode stays Java 17.
build:jdk17 --java_runtime_version=remotejdk_17
build:jdk21 --java_runtime_version=remotejdk_21
build:jdk25 --java_runtime_version=remotejdk_25

# Error Prone runs inside every javac action (it ships with Bazel's java_tools).
# Strict warnings (-Xlint:all -Werror) are NOT set globally, so external code is never
# held to them: first-party targets opt in with JAVACOPTS from //bazel/java:defs.bzl.

# Deterministic, hermetic-ish test runs.
test --test_output=errors
test --test_verbose_timeout_warnings
# JUnit tests get a clean env; add --test_env=NAME explicitly when one needs it.
test --incompatible_strict_action_env

# Tests that need a real Kafka broker or a SPIRE server carry the `e2e` tag and are
# excluded from plain `bazel test //...`; `--config=e2e` selects them instead (a
# later --test_tag_filters wins). Results are never cached.
test --test_tag_filters=-e2e
test:e2e --test_tag_filters=e2e
test:e2e --nocache_test_results
# Testcontainers finds Docker through these when they are set (HOME for its own and
# Docker's configuration files); otherwise through /var/run/docker.sock.
test:e2e --test_env=HOME --test_env=DOCKER_HOST --test_env=TESTCONTAINERS_RYUK_DISABLED

# Reproducible dependency state: pin the resolved Maven trees and let CI refuse
# any drift of the module lockfile instead of silently rewriting it.
common --lockfile_mode=update
common:ci --lockfile_mode=error

# Lint (usage: bazel build --config=lint //...). Findings are warnings.
build:lint --aspects=//bazel/lint:linters.bzl%pmd
# "+" adds the lint reports to the default outputs. Replacing them would leave
# `bazel run` under this config with nothing to execute.
build:lint --output_groups=+rules_lint_report
# CI lint: fail the build on violations.
build:ci --config=lint
build:ci --@aspect_rules_lint//lint:fail_on_violation
build:ci --color=yes
common:ci --noshow_progress
common:ci --noshow_loading_progress
test:ci --test_output=errors

# LLM-friendly output (usage: --config=llm)
common:llm --color=no
common:llm --curses=no
build:llm --verbose_failures
test:llm --test_summary=detailed

# User-specific overrides (gitignored): remote cache, disk cache, output roots.
try-import %workspace%/user.bazelrc
